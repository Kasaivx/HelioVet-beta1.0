generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id  Int   @id @default(autoincrement())
  dayOfWeek    String?
  startTime    DateTime?
  endTime      DateTime?
  latitude     Float?
  longitude    Float?
  vet Vet[]
}

/// VET STUFF///
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  phone     String   @unique
  owner     Owner?
  vet       Vet?
}

model Vet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  fullName     String
  licenseUrl   String?
  idCardUrl    String?
  phone        String
  status       VetStatus     @default(PENDING)
  clinicId     Int?
  appointments Appointment[]
  usagelogs    InvLog[]
  clinic       Clinic?       @relation(fields: [clinicId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
}

model Owner {
  id       Int       @id @default(autoincrement())
  userId   Int       @unique
  name     String
  phone    String
  user     User      @relation(fields: [userId], references: [id])
  patients Patient[]
}

model Patient {
  id           Int           @id @default(autoincrement())
  species      String
  breed        String
  age          Int?
  ownerId      Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  PetName      String
  appointments Appointment[]
  owner        Owner         @relation(fields: [ownerId], references: [id])
}

model Appointment {
  id        Int               @id @default(autoincrement())
  date      DateTime
  reason    String
  status    AppointmentStatus @default(PENDING)
  patientID Int
  vetID     Int
  patient   Patient           @relation(fields: [patientID], references: [id])
  vet       Vet               @relation(fields: [vetID], references: [id])
  medRec    MedicalRecord[]
}

model MedicalRecord {
  id            Int          @id @default(autoincrement())
  appointmentID Int
  diagnosis     String?
  treatment     String?
  notes         String?
  instructions  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  nextVisitDate DateTime?
  attachments   Attachment[]
  appointment   Appointment  @relation(fields: [appointmentID], references: [id])
}

model Attachment {
  id         Int           @id @default(autoincrement())
  url        String
  type       String?
  medRecID   Int
  uploadedAt DateTime      @default(now())
  medRec     MedicalRecord @relation(fields: [medRecID], references: [id])
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  qr         String?
  quantity   Int
  expiryDate DateTime
  isActive   Boolean  @default(true)
  log        InvLog[]
}

model InvLog {
  id            Int          @id @default(autoincrement())
  prdctID       Int
  vetID         Int
  timestamp     DateTime     @default(now())
  action        Action
  changedAmount String?
  method        ActionMethod
  prdct         Product      @relation(fields: [prdctID], references: [id])
  vet           Vet          @relation(fields: [vetID], references: [id])
}

/// enums///
enum AppointmentStatus {
  PENDING
  CONFIRMED
  INPROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  VET
  STAFF
  OWNER
  ADMIN
}

enum VetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Action {
  ADD
  USE
}

enum ActionMethod {
  MANUAL
  SCAN
}
